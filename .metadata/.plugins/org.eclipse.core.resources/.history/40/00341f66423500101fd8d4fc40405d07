spring:
  application:
    name: API-Gateway
    
server:
  port: 8080
  
cloud:
    gateway:
      routes:
        - id: service-a
          uri: lb://A
          predicates:
            - Path=/a/**

        - id: service-b
          uri: lb://B
          predicates:
            - Path=/b/**

    discovery:
      locator:
        enabled: true
        lower-case-service-id: true

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka/
